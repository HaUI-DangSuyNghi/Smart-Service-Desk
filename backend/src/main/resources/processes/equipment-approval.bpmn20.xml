  <process id="equipment-approval" name="Equipment approval probe" isExecutable="true">
    <startEvent id="start"/><sequenceFlow id="s1" sourceRef="start" targetRef="approve"/>
    <userTask id="approve" name="Approve request" flowable:assignee="${initiator}"/>
