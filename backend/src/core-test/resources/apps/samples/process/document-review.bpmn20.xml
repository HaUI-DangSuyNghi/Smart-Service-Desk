<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="https://haui.vn/dx/core">
  <process id="document-review" name="Independent document review" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toReview" sourceRef="start" targetRef="review"/>
    <userTask id="review" name="Review document" flowable:candidateGroups="${workspace}:coordinator"/>
    <sequenceFlow id="toDecision" sourceRef="review" targetRef="decision"/>
    <exclusiveGateway id="decision"/>
    <sequenceFlow id="accept" sourceRef="decision" targetRef="approved">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${outcome_review == 'approved'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="reject" sourceRef="decision" targetRef="rejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${outcome_review == 'rejected'}]]></conditionExpression>
    </sequenceFlow>
    <endEvent id="approved"/>
    <endEvent id="rejected"/>
  </process>
</definitions>
