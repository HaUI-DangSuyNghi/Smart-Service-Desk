<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.3.13</version></parent>
  <groupId>vn.haui.dx</groupId><artifactId>dx-platform</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties>
    <java.version>17</java.version>
    <tomcat.version>10.1.61</tomcat.version>
    <postgresql.version>42.7.12</postgresql.version>
    <jackson-bom.version>2.18.11</jackson-bom.version>
    <dx.resource.app1>__none__</dx.resource.app1><dx.resource.app2>__none__</dx.resource.app2>
    <dx.resource.migration1>__none__</dx.resource.migration1><dx.resource.migration2>__none__</dx.resource.migration2><dx.resource.migration3>__none__</dx.resource.migration3>
  </properties>
  <dependencies>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.7</version></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>1.5.9</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-oauth2-resource-server</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.flowable</groupId><artifactId>flowable-spring-boot-starter-process</artifactId><version>7.1.0</version></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit</artifactId><version>1.3.0</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory><excludes>
        <exclude>${dx.resource.app1}</exclude><exclude>${dx.resource.app2}</exclude>
        <exclude>${dx.resource.migration1}</exclude><exclude>${dx.resource.migration2}</exclude><exclude>${dx.resource.migration3}</exclude><exclude>${dx.resource.migration4}</exclude>
      </excludes></resource>
      <resource><directory>../contracts/intelligence/v1</directory><targetPath>intelligence-contract</targetPath><includes><include>triage-*.schema.json</include></includes></resource>
    </resources>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource><directory>../contracts/apps/servicedesk/intelligence</directory><targetPath>servicedesk-contract</targetPath><includes><include>ticket-*.schema.json</include><include>examples/ticket-assessment-v0.2.fixture.json</include></includes></testResource>
    </testResources>
    <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><mainClass>vn.haui.dx.assembly.DxOsApplication</mainClass></configuration></plugin></plugins>
  </build>
  <profiles>
    <profile>
      <id>core-only</id>
      <properties>
        <dx.resource.app1>apps/**</dx.resource.app1>
        <dx.resource.migration4>db/migration/hpdi/**</dx.resource.migration4>
        <dx.resource.migration1>db/migration/apps/**</dx.resource.migration1>
        <dx.resource.migration2>db/migration/V5__servicedesk_ticket.sql</dx.resource.migration2>
        <dx.resource.migration3>db/migration/V6__decouple_servicedesk_workflow_reference.sql</dx.resource.migration3>
      </properties>
      <build>
        <testResources>
          <testResource><directory>src/test/resources</directory></testResource>
          <testResource><directory>src/core-test/resources</directory></testResource>
        </testResources>
        <plugins>
          <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><skip>true</skip></configuration></plugin>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration>
            <excludes><exclude>vn/haui/dx/apps/**</exclude><exclude>vn/haui/dx/hpdi/**</exclude><exclude>vn/haui/dx/assembly/**</exclude></excludes>
            <testExcludes><testExclude>vn/haui/dx/apps/**</testExclude><testExclude>vn/haui/dx/hpdi/**</testExclude><testExclude>vn/haui/dx/architecture/**</testExclude></testExcludes>
          </configuration></plugin>
          <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration>
            <systemPropertyVariables><spring.profiles.active>core-only</spring.profiles.active><dx.proof.core-only>true</dx.proof.core-only></systemPropertyVariables>
          </configuration></plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>second-domain</id>
      <properties>
        <dx.resource.migration4>db/migration/apps/servicedesk/**</dx.resource.migration4>
        <dx.resource.app1>apps/servicedesk/**</dx.resource.app1><dx.resource.app2>apps/samples/**</dx.resource.app2>
        <dx.resource.migration1>db/migration/V5__servicedesk_ticket.sql</dx.resource.migration1>
        <dx.resource.migration2>db/migration/V6__decouple_servicedesk_workflow_reference.sql</dx.resource.migration2>
        <dx.resource.migration3>db/migration/apps/servicedesk/**</dx.resource.migration3>
      </properties>
      <build>
        <testResources>
          <testResource><directory>src/test/resources</directory></testResource>
          <testResource><directory>src/core-test/resources</directory></testResource>
        </testResources>
        <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration>
          <excludes><exclude>vn/haui/dx/apps/servicedesk/**</exclude><exclude>vn/haui/dx/apps/samples/**</exclude></excludes>
          <testExcludes><testExclude>vn/haui/dx/apps/servicedesk/**</testExclude></testExcludes>
        </configuration></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration>
          <systemPropertyVariables><dx.proof.second-domain>true</dx.proof.second-domain></systemPropertyVariables>
        </configuration></plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
