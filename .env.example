# scripts/setup.ps1 creates .env from this template and adds missing settings on later runs.
# Internal credentials are generated locally; provide your own API key to enable Q&A.
POSTGRES_PASSWORD=
# Persisted development startup preference: disabled | rules | model | api.
# scripts/start.ps1 -Model checks/starts Qwen and saves AI_MODE=model here.
AI_MODE=disabled
LOCAL_MODEL_IMAGE=ssd-ai07-qwen-full:a40d655f95f8ed6b
# auto applies AI in every authorized workspace; set IDs only to intentionally restrict it.
LOCAL_MODEL_WORKSPACES=auto
# API mode still uses the rule engine. Choose openai | groq | gemini.
# No default model: select an available model from your provider account.
AI_API_PROVIDER=
AI_API_MODEL=
AI_API_BASE_URL=
AI_API_KEY=
AI_API_KEY_FILE=
AI_API_RESPONSE_FORMAT=json_object
AI_API_MAX_TOKENS=1024
# API Q&A can run alongside Qwen classification: scripts/start.ps1 -Model -AskApi.
AI_ASSISTANCE_MODE=disabled
AI_ASSISTANCE_MAX_TOKENS=2048
KC_ADMIN_PASSWORD=
DEMO_PASSWORD=
DIRECTORY_CLIENT_SECRET=
BACKGROUND_CLIENT_SECRET=
SERVICE_DESK_BACKGROUND_WORKSPACES=lab-a
INTELLIGENCE_TRIAGE_BASE_URL=
INTELLIGENCE_TRIAGE_TOKEN=
INTELLIGENCE_ASSISTANCE_BASE_URL=
INTELLIGENCE_ASSISTANCE_TOKEN=
HDPI_ASSISTANCE_REFERENCE_ENABLED=0
HDPI_ASSISTANCE_CONFIG_SHA256=
SERVICE_DESK_ASSISTANCE_ENABLED=false
SERVICE_DESK_ASSISTANCE_MODE=disabled
SERVICE_DESK_ASSISTANCE_SOURCE_PINS=

# API-first assistance: server-only credentials; never use VITE_ names.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY_FILE=
GROQ_API_KEY_FILE=
PROVIDER_MODE=disabled
PROVIDER_CATALOG_PATH=
PROVIDER_CATALOG_SHA256=
CLOUD_EGRESS_APPROVAL_FILE=
CLOUD_EGRESS_APPROVAL_SHA256=
CLOUD_ISOLATION_FILE=
CLOUD_ENVIRONMENT=disabled
CLOUD_EGRESS_PROXY=
# AI07 assessment: mặc định tắt; cần grant độc lập ký hash bộ chính sách.
SERVICE_DESK_ASSESSMENT_ENABLED=false
SERVICE_DESK_ASSESSMENT_POLICY_BUNDLE_DIGEST=
# Gợi ý ngữ cảnh / ticket trùng: true = bật, false = tắt (mặc định).
# Lưu bổ sung theo ticket ID không phụ thuộc cờ AI.
SERVICE_DESK_CONTEXT_ENABLED=false
# DISABLED = tắt; SHADOW = chạy ẩn; ASSISTED = trả gợi ý cần duyệt.
# PROMOTED hiện bị chặn; không bật để thay thế phê duyệt phát hành.
SERVICE_DESK_CONTEXT_MODE=DISABLED
# SHA-256 bộ policy; đường dẫn grant; khóa HMAC >= 32 ký tự, do bên có thẩm quyền cấp.
SERVICE_DESK_CONTEXT_POLICY_BUNDLE_DIGEST=
SERVICE_DESK_CONTEXT_PROCESSING_RECEIPT=
SERVICE_DESK_CONTEXT_PROCESSING_VERIFICATION_KEY=
# true/false: lifecycle advisory và timer metadata; mặc định tắt cả hai.
# Deadline DRAFT trong readiness policy không phải SLA, không tạm dừng workflow.
SERVICE_DESK_ENRICHMENT_ENABLED=false
SERVICE_DESK_ENRICHMENT_TIMERS_ENABLED=false
# Chu kỳ quét deadline (mili giây), tối đa 50 case/đợt.
SERVICE_DESK_ENRICHMENT_POLL_DELAY_MS=60000
# true/false: model trên input có bổ sung; mặc định false, facts CPU vẫn có thể đánh giá lại.
# Chỉ bật với benchmark/approval và grant pin policy mới. Không thay thế AI07 v0.2.
SERVICE_DESK_CONTEXTUAL_ASSESSMENT_ENABLED=false
SERVICE_DESK_CONTEXTUAL_ASSESSMENT_POLICY_DIGEST=
SERVICE_DESK_INTAKE_NEW_TICKETS=false
SERVICE_DESK_INTAKE_TRUE_WAIT=false
SERVICE_DESK_CANONICAL_HUMAN_ENABLED=false
SERVICE_DESK_INTAKE_TIMEOUT_SECONDS=86400
