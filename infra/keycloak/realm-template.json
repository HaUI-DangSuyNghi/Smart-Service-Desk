{
  "realm": "dx-lab",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "roles": {
    "realm": [{"name": "platform-admin", "description": "Platform administration; no implicit access to workspace content"}],
    "client": {
      "dx-permissions": [
        {"name": "request:create", "description": "Tạo yêu cầu"},
        {"name": "request:view-all", "description": "Xem mọi yêu cầu trong workspace"},
        {"name": "task:handle", "description": "Xử lý công việc"},
        {"name": "task:assign", "description": "Giao việc cho người khác"},
        {"name": "document:view", "description": "Xem tài liệu"},
        {"name": "document:upload", "description": "Tải tài liệu lên"},
        {"name": "member:view", "description": "Xem danh sách thành viên"},
        {"name": "audit:view", "description": "Xem nhật ký hoạt động của mọi người trong workspace"},
        {"name": "audit:view-own", "description": "Xem hoạt động của chính mình"}
      ]
    }
  },
  "groups": [{
    "name": "workspaces",
    "subGroups": [
      {"name": "lab-a", "attributes": {"displayName": ["Phòng máy A"]}, "subGroups": [
        {"name": "requester", "clientRoles": {"dx-permissions": ["request:create", "audit:view-own"]}},
        {"name": "agent", "clientRoles": {"dx-permissions": ["request:create", "task:handle", "document:view", "document:upload", "audit:view-own"]}},
        {"name": "coordinator", "clientRoles": {"dx-permissions": ["request:create", "request:view-all", "task:handle", "task:assign", "document:view", "document:upload", "member:view", "audit:view", "audit:view-own"]}}
      ]},
      {"name": "lab-b", "attributes": {"displayName": ["Phòng máy B"]}, "subGroups": [
        {"name": "requester", "clientRoles": {"dx-permissions": ["request:create", "audit:view-own"]}},
        {"name": "agent", "clientRoles": {"dx-permissions": ["request:create", "task:handle", "document:view", "document:upload", "audit:view-own"]}},
        {"name": "coordinator", "clientRoles": {"dx-permissions": ["request:create", "request:view-all", "task:handle", "task:assign", "document:view", "document:upload", "member:view", "audit:view", "audit:view-own"]}}
      ]}
    ]
  }],
  "clients": [
    {
      "clientId": "dx-permissions",
      "name": "Quyền ứng dụng DX",
      "description": "Chỉ chứa danh sách quyền để gán cho nhóm /workspaces/{ws}/{role}; không dùng để đăng nhập. Backend đọc quyền theo nhóm qua Admin API, không tin resource_access trong token vì token không ghi quyền thuộc workspace nào",
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "dx-directory",
      "description": "Backend reads workspace members via Admin API (service account, read-only). Secret set by scripts/setup.ps1",
      "publicClient": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "set-by-setup"
    },
    {
      "clientId": "core-probe",
      "description": "Test scripts only (smoke.ps1)",
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "core-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "dx-core", "access.token.claim": "true"}
        },
        {
          "name": "workspaces", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
          "config": {"claim.name": "groups", "full.path": "true", "access.token.claim": "true"}
        }
      ]
    },
    {
      "clientId": "dx-web",
      "description": "Tier 2 frontend (Authorization Code + PKCE)",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:9080/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:9080"],
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:9080/*"},
      "protocolMappers": [
        {
          "name": "core-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "dx-core", "access.token.claim": "true"}
        },
        {
          "name": "workspaces", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
          "config": {"claim.name": "groups", "full.path": "true", "access.token.claim": "true"}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-dx-directory", "enabled": true, "serviceAccountClientId": "dx-directory",
      "clientRoles": {"realm-management": ["view-users", "query-users", "query-groups"]}
    },
    {
      "username": "user1", "enabled": true, "email": "user1@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Requester", "groups": ["/workspaces/lab-a/requester"]
    },
    {
      "username": "user2", "enabled": true, "email": "user2@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Agent", "groups": ["/workspaces/lab-a/agent"]
    },
    {
      "username": "user3", "enabled": true, "email": "user3@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Coordinator", "groups": ["/workspaces/lab-a/coordinator"]
    },
    {
      "username": "user4", "enabled": true, "email": "user4@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Requester", "groups": ["/workspaces/lab-b/requester"]
    },
    {
      "username": "user5", "enabled": true, "email": "user5@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Agent", "groups": ["/workspaces/lab-b/agent"]
    },
    {
      "username": "user6", "enabled": true, "email": "user6@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Coordinator", "groups": ["/workspaces/lab-b/coordinator"]
    },
    {
      "username": "user7", "enabled": true, "email": "user7@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Administrator", "groups": [], "realmRoles": ["platform-admin"],
      "clientRoles": {"realm-management": ["realm-admin"]}
    },
    {
      "username": "superadmin", "enabled": true, "email": "superadmin@example.com", "emailVerified": true,
      "firstName": "Demo", "lastName": "Super Admin",
      "groups": [
        "/workspaces/lab-a/requester", "/workspaces/lab-a/agent", "/workspaces/lab-a/coordinator",
        "/workspaces/lab-b/requester", "/workspaces/lab-b/agent", "/workspaces/lab-b/coordinator"
      ],
      "realmRoles": ["platform-admin"],
      "clientRoles": {"realm-management": ["realm-admin"]}
    }
  ]
}
