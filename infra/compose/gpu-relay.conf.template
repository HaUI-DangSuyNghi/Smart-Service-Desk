# Relay tới Qwen trên máy GPU (compose.model-remote.yaml). scripts/start-model.ps1 -Remote thay ${REMOTE_MODEL_HOST}
# rồi ghi ra .local/gpu-worker/relay.conf. Header CF-Access-* nằm trong cloudflare-headers.conf (secret, không commit).
server {
    listen 8003;
    server_tokens off;
    access_log off;
    error_log /dev/stderr crit;
    client_max_body_size 16k;
    client_body_timeout 5s;

    # Healthcheck của container: chỉ cho biết relay đang chạy
    location = /relay-health {
        return 200;
    }

    proxy_pass_request_headers off;
    proxy_set_header Host ${REMOTE_MODEL_HOST};
    # Giữ Bearer của backend (token Qwen), thêm cặp header Cloudflare Access
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Accept application/json;
    include /run/secrets/cloudflare-headers.conf;

    proxy_ssl_server_name on;
    proxy_ssl_name ${REMOTE_MODEL_HOST};
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_connect_timeout 3s;
    proxy_send_timeout 5s;
    # Deadline tổng do backend áp (INTELLIGENCE_CLASSIFICATION_TIMEOUT_MS = 20 giây)
    proxy_read_timeout 20s;
    proxy_next_upstream off;
    proxy_buffering off;

    location = /health/ready {
        limit_except GET { deny all; }
        proxy_pass https://${REMOTE_MODEL_HOST};
    }
    location = /internal/intelligence/v1/classify {
        limit_except POST { deny all; }
        proxy_pass https://${REMOTE_MODEL_HOST};
    }
    location / {
        return 404;
    }
}
