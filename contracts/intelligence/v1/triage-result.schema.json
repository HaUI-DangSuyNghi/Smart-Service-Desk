{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Intelligence triage response 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "profile", "workspace_id", "status", "result", "evidence", "explanation", "runtime", "needs_review", "error"],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "request_id": {"$ref": "#/$defs/nonblank"},
    "profile": {"$ref": "#/$defs/nonblank"},
    "workspace_id": {"$ref": "#/$defs/nonblank"},
    "status": {"enum": ["SUCCESS", "DEGRADED"]},
    "result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "explanation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/explanation"}]},
    "runtime": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/runtime"}]},
    "needs_review": {"type": "boolean"},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCESS"}}},
      "then": {"properties": {
        "result": {"$ref": "#/$defs/result"},
        "evidence": {"minItems": 1},
        "explanation": {"$ref": "#/$defs/explanation"},
        "runtime": {"$ref": "#/$defs/runtime"},
        "error": {"type": "null"}
      }},
      "else": {"properties": {
        "result": {"type": "null"}, "evidence": {"maxItems": 0},
        "explanation": {"type": "null"}, "runtime": {"type": "null"},
        "needs_review": {"const": true}, "error": {"$ref": "#/$defs/error"}
      }}
    },
    {
      "if": {"properties": {"explanation": {"type": "object", "properties": {"reason_code": {"const": "INSUFFICIENT_INFORMATION"}}, "required": ["reason_code"]}}, "required": ["explanation"]},
      "then": {"properties": {"needs_review": {"const": true}}}
    },
    {
      "if": {"properties": {"runtime": {"type": "object", "required": ["rules_version"]}}, "required": ["runtime"]},
      "then": {"properties": {"explanation": {"type": "object", "properties": {"matched_rules": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"explanation": {"type": "object", "properties": {"matched_rules": {"minItems": 1}}, "required": ["matched_rules"]}}, "required": ["explanation"]},
      "then": {"properties": {"runtime": {"type": "object", "required": ["rules_version"]}}}
    }
  ],
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "priority", "suggested_group"],
      "properties": {
        "category": {"$ref": "#/$defs/nonblank"},
        "priority": {"$ref": "#/$defs/nonblank"},
        "suggested_group": {"$ref": "#/$defs/nonblank"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "field", "text"],
      "properties": {
        "type": {"const": "INPUT"}, "field": {"enum": ["title", "description"]},
        "text": {"$ref": "#/$defs/nonblank"}
      }
    },
    "explanation": {
      "type": "object", "additionalProperties": false,
      "required": ["matched_rules", "impact", "urgency", "reason_code", "text"],
      "properties": {
        "matched_rules": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}},
        "impact": {"type": ["string", "null"]}, "urgency": {"type": ["string", "null"]},
        "reason_code": {"enum": ["CLASSIFIED", "ROOT_CAUSE_CONFLICT", "INSUFFICIENT_INFORMATION"]},
        "text": {"$ref": "#/$defs/nonblank"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "profile_version"],
      "anyOf": [{"required": ["rules_version"]}, {"required": ["model_version"]}],
      "properties": {
        "engine": {"$ref": "#/$defs/nonblank"},
        "profile_version": {"$ref": "#/$defs/nonblank"},
        "rules_version": {"$ref": "#/$defs/nonblank"},
        "model_version": {"$ref": "#/$defs/nonblank"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": {"code": {"const": "INTELLIGENCE_UNAVAILABLE"}}
    }
  }
}
