{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Intelligence triage response 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "profile", "workspaceId", "status", "result", "evidence", "explanation", "runtime", "needsReview", "error"],
  "properties": {
    "contractVersion": {"const": "0.1.0"},
    "requestId": {"$ref": "#/$defs/nonblank"},
    "profile": {"$ref": "#/$defs/nonblank"},
    "workspaceId": {"$ref": "#/$defs/nonblank"},
    "status": {"enum": ["SUCCESS", "DEGRADED"]},
    "result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "explanation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/explanation"}]},
    "runtime": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/runtime"}]},
    "needsReview": {"type": "boolean"},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCESS"}}},
      "then": {"properties": {
        "result": {"$ref": "#/$defs/result"},
        "evidence": {"minItems": 1},
        "explanation": {"$ref": "#/$defs/explanation"},
        "runtime": {"$ref": "#/$defs/runtime"},
        "error": {"type": "null"}
      }},
      "else": {"properties": {
        "result": {"type": "null"}, "evidence": {"maxItems": 0},
        "explanation": {"type": "null"}, "runtime": {"type": "null"},
        "needsReview": {"const": true}, "error": {"$ref": "#/$defs/error"}
      }}
    },
    {
      "if": {"properties": {"explanation": {"type": "object", "properties": {"reasonCode": {"const": "INSUFFICIENT_INFORMATION"}}, "required": ["reasonCode"]}}, "required": ["explanation"]},
      "then": {"properties": {"needsReview": {"const": true}}}
    },
    {
      "if": {"properties": {"runtime": {"type": "object", "required": ["rulesVersion"]}}, "required": ["runtime"]},
      "then": {"properties": {"explanation": {"type": "object", "properties": {"matchedRules": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"explanation": {"type": "object", "properties": {"matchedRules": {"minItems": 1}}, "required": ["matchedRules"]}}, "required": ["explanation"]},
      "then": {"properties": {"runtime": {"type": "object", "required": ["rulesVersion"]}}}
    }
  ],
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "priority", "suggestedGroup"],
      "properties": {
        "category": {"$ref": "#/$defs/nonblank"},
        "priority": {"$ref": "#/$defs/nonblank"},
        "suggestedGroup": {"$ref": "#/$defs/nonblank"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "field", "text"],
      "properties": {
        "type": {"const": "INPUT"}, "field": {"enum": ["title", "description"]},
        "text": {"$ref": "#/$defs/nonblank"}
      }
    },
    "explanation": {
      "type": "object", "additionalProperties": false,
      "required": ["matchedRules", "impact", "urgency", "reasonCode", "text"],
      "properties": {
        "matchedRules": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}},
        "impact": {"type": ["string", "null"]}, "urgency": {"type": ["string", "null"]},
        "reasonCode": {"enum": ["CLASSIFIED", "ROOT_CAUSE_CONFLICT", "INSUFFICIENT_INFORMATION"]},
        "text": {"$ref": "#/$defs/nonblank"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "profileVersion"],
      "anyOf": [{"required": ["rulesVersion"]}, {"required": ["modelVersion"]}],
      "properties": {
        "engine": {"$ref": "#/$defs/nonblank"},
        "profileVersion": {"$ref": "#/$defs/nonblank"},
        "rulesVersion": {"$ref": "#/$defs/nonblank"},
        "modelVersion": {"$ref": "#/$defs/nonblank"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": {"code": {"const": "INTELLIGENCE_UNAVAILABLE"}}
    }
  }
}
