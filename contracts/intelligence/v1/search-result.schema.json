{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Intelligence search response 0.1.0",
  "description": "Logical response only. Echo request context, cap hits at top_k and verify every citation via authorized Core records in the adapter; UUID shape cannot prove Core issuance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "profile",
    "workspace_id",
    "status",
    "results",
    "runtime",
    "needs_review",
    "error"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "$ref": "#/$defs/nonblank"
    },
    "profile": {
      "$ref": "#/$defs/nonblank"
    },
    "workspace_id": {
      "$ref": "#/$defs/nonblank"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "DEGRADED"
      ]
    },
    "results": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/hit"
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/runtime"
        }
      ]
    },
    "needs_review": {
      "type": "boolean"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCESS"
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "$ref": "#/$defs/runtime"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "maxItems": 0
          },
          "runtime": {
            "type": "null"
          },
          "needs_review": {
            "const": true
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "metadata_id",
        "source_version",
        "source_checksum",
        "chunk_id",
        "score",
        "excerpt"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/nonblank"
        },
        "metadata_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Core-issued UUID, resolved with authorized workspace; local kb-* IDs cannot serve as citations."
        },
        "source_version": {
          "$ref": "#/$defs/nonblank"
        },
        "source_checksum": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Exact source-byte SHA-256; format alone does not attest Core file-integrity verification."
        },
        "chunk_id": {
          "$ref": "#/$defs/nonblank"
        },
        "score": {
          "type": "number",
          "description": "Finite engine-specific ranking score; not probability/confidence and not calibrated across engines. Adapter rejects NaN/Infinity."
        },
        "excerpt": {
          "$ref": "#/$defs/nonblank"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "profile_version",
        "corpus_version",
        "index_version"
      ],
      "properties": {
        "engine": {
          "$ref": "#/$defs/nonblank"
        },
        "engine_version": {
          "$ref": "#/$defs/nonblank"
        },
        "profile_version": {
          "$ref": "#/$defs/nonblank"
        },
        "corpus_version": {
          "$ref": "#/$defs/nonblank"
        },
        "index_version": {
          "$ref": "#/$defs/nonblank"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "const": "INTELLIGENCE_UNAVAILABLE"
        }
      }
    }
  }
}
