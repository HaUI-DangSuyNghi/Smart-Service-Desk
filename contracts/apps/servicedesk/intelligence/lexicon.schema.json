{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service Desk lexicon v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "concepts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "version": {
      "const": "0.2.0"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conceptId",
          "preferredTerm",
          "variants",
          "language",
          "scope",
          "ambiguity",
          "owner",
          "reviewStatus",
          "provenance"
        ],
        "properties": {
          "conceptId": {
            "type": "string",
            "minLength": 1
          },
          "preferredTerm": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "language": {
            "const": "vi-en"
          },
          "scope": {
            "const": "service-desk"
          },
          "ambiguity": {
            "enum": [
              "low",
              "contextual",
              "high"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "enum": [
              "DRAFT",
              "REVIEWED"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "generationSource",
              "humanReviewed",
              "reviewer"
            ],
            "additionalProperties": false,
            "properties": {
              "generationSource": {
                "enum": [
                  "LLM_DRAFT",
                  "HUMAN_AUTHORED"
                ]
              },
              "humanReviewed": {
                "type": "boolean"
              },
              "reviewer": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
