                  "type": "string",
                  "minLength": 1
                },
                "authoringIndependent": {
                  "const": true
                },
                "collectionDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "queriesDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "qrelsDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "projectionDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "frozenBeforeEvaluation": {
                  "const": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
