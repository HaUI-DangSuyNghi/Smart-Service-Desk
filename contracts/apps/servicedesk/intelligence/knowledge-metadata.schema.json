{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service Desk knowledge-metadata v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "version",
    "title",
    "status",
    "language",
    "domain",
    "primaryIntent",
    "categories",
    "conceptIds",
    "positiveSignals",
    "negativeSignals",
    "relatedArtifacts",
    "owner",
    "sourceClass",
    "rightsStatus",
    "provenance",
    "createdAt",
    "reviewedAt",
    "legacyFamily",
    "raw",
    "curated",
    "derivedFrom"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "0.2.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEWED"
      ]
    },
    "language": {
      "const": "vi-en"
    },
    "domain": {
      "const": "service-desk"
    },
    "primaryIntent": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "NETWORK",
          "ACCOUNT",
          "SOFTWARE",
          "HARDWARE",
          "OTHER"
        ]
      }
    },
    "conceptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "positiveSignals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negativeSignals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relatedArtifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "sourceClass": {
      "enum": [
        "OFFICIAL_POLICY",
        "DOMAIN_OWNER_AUTHORED",
        "TEAM_AUTHORED_SYNTHETIC",
        "IMPORTED_REFERENCE"
      ]
    },
    "rightsStatus": {
      "enum": [
        "PENDING_OWNER_APPROVAL",
        "APPROVED_INTERNAL_EVAL"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "generationSource",
        "humanReviewed",
        "reviewer"
      ],
      "additionalProperties": false,
      "properties": {
        "generationSource": {
          "enum": [
            "LLM_DRAFT",
            "HUMAN_AUTHORED"
          ]
        },
        "humanReviewed": {
          "type": "boolean"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewedAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "legacyFamily": {
      "type": "string",
      "minLength": 1
    },
    "raw": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "byteSize"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "curated": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "byteSize"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "derivedFrom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "path",
          "sha256"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "reviewDecision": {
      "type": "string",
      "enum": [
        "DOCUMENT_ACCEPT",
        "DOCUMENT_REVISE",
        "DOCUMENT_REJECT"
      ]
    }
  }
}
