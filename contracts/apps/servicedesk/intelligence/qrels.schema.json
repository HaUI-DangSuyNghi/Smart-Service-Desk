{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service Desk qrels v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "collectionDigest",
    "queriesDigest",
    "status",
    "annotationKind",
    "benchmarkClaim",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "datasetVersion": {
      "const": "0.2.0"
    },
    "collectionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "queriesDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "AWAITING_HUMAN_JUDGMENTS",
        "REVIEWED"
      ]
    },
    "annotationKind": {
      "const": "HUMAN_REQUIRED"
    },
    "benchmarkClaim": {
      "const": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queryId",
          "judgments"
        ],
        "properties": {
          "queryId": {
            "type": "string",
            "minLength": 1
          },
          "judgments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactId",
                "grade",
                "reason",
                "reviews",
                "adjudication"
              ],
              "properties": {
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                },
                "grade": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "enum": [
                    0,
                    1,
                    2,
                    null
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reviews": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "reviewer",
                      "grade",
                      "reason",
                      "independent",
                      "queryReviewed"
                    ],
                    "properties": {
                      "reviewer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "grade": {
                        "type": "integer",
                        "enum": [
                          0,
                          1,
                          2
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "independent": {
                        "const": true
                      },
                      "queryReviewed": {
                        "const": true
                      }
                    }
                  }
                },
                "adjudication": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "reviewer",
                        "grade",
                        "reason",
                        "role"
                      ],
                      "properties": {
                        "reviewer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "grade": {
                          "type": "integer",
                          "enum": [
                            0,
                            1,
                            2
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        },
                        "role": {
                          "const": "DOMAIN_OWNER"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
