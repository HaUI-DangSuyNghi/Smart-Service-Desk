# Copy thành .env (Git bỏ qua .env). Giá trị dưới đây khớp stack chạy local bằng scripts/start.ps1.

# Phải đúng issuer backend kiểm (backend/src/main/resources/application.yml); không đi qua proxy Vite
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/dx-lab
VITE_OIDC_CLIENT_ID=dx-web

# true: dùng dữ liệu giả cho phần backend chưa cài (hàng đợi, duyệt, ca trực, cảnh báo, cấu hình),
# theo contracts/*-target.yaml. Dữ liệu nằm trong bộ nhớ, tải lại trang là mất. Sửa xong chạy lại npm run dev.
VITE_WORKFLOW_MOCK=false
