    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-table": "9.3.1",
    "axios": "1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "oidc-client-ts": "3.5.0",
