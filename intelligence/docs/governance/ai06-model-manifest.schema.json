{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hdpi:ai06:model-manifest:1",
  "title": "Offline governed selection model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model", "revision", "quantization", "backend", "backend_version", "serving_image",
    "tokenizer_version", "license_id", "artifacts", "approvals", "limits"
  ],
  "properties": {
    "model": {"$ref": "#/$defs/identity"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "quantization": {"$ref": "#/$defs/identity"},
    "backend": {"$ref": "#/$defs/identity"},
    "backend_version": {"$ref": "#/$defs/identity"},
    "serving_image": {"$ref": "#/$defs/digest"},
    "tokenizer_version": {"$ref": "#/$defs/identity"},
    "license_id": {"$ref": "#/$defs/identity"},
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_./-]+$"},
          "kind": {"enum": ["weights", "tokenizer", "config", "chat-template", "license", "quantization"]},
          "sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "data", "privacy", "security", "platform"],
      "properties": {
        "model": {"$ref": "#/$defs/digest"},
        "data": {"$ref": "#/$defs/digest"},
        "privacy": {"$ref": "#/$defs/digest"},
        "security": {"$ref": "#/$defs/digest"},
        "platform": {"$ref": "#/$defs/digest"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_request_bytes", "max_response_bytes", "context_tokens", "output_tokens",
        "connect_seconds", "read_seconds", "total_seconds", "concurrency", "requests_per_minute"
      ],
      "properties": {
        "max_request_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 16384},
        "context_tokens": {"type": "integer", "minimum": 1, "maximum": 131072},
        "output_tokens": {"type": "integer", "minimum": 1, "maximum": 512},
        "connect_seconds": {"type": "integer", "minimum": 1, "maximum": 10},
        "read_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "total_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "requests_per_minute": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.+/-]+$",
      "not": {"enum": ["main", "latest", "pending", "to_be_pinned", "blocked"]}
    }
  }
}
