FROM python:3.12.7-slim@sha256:60d9996b6a8a3689d36db740b49f4327be3be09a21122bd02fb8895abb38b50d

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1

COPY requirements-qwen-linux.lock /run/build/requirements.lock
# Installing the large CUDA wheels separately avoids retaining the whole download set
# while unpacking it. The resolved versions remain fixed by the same lock.
RUN set -eu; \
    while IFS= read -r requirement; do \
        case "$requirement" in ""|\#*|--*) continue ;; esac; \
        python -m pip install --no-cache-dir --no-deps \
            --extra-index-url https://download.pytorch.org/whl/cu128 "$requirement"; \
    done < /run/build/requirements.lock
COPY wheels/*.whl /run/build/wheels/
RUN python -m pip install --no-cache-dir --no-deps /run/build/wheels/*.whl \
    && python -m pip check \
    && rm -rf /run/build

RUN groupadd --gid 10001 qwen \
    && useradd --uid 10001 --gid qwen --no-create-home \
        --home-dir /tmp/qwen --shell /usr/sbin/nologin qwen

ENV USER=qwen \
    LOGNAME=qwen \
    HOME=/tmp/qwen

USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["python", "-m", "local_classification.qwen_lora_server"]
