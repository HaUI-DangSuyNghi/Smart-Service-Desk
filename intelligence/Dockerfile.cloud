FROM python:3.12.15-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS build

WORKDIR /build

COPY intelligence/requirements.lock intelligence/requirements.lock

ENV PIP_DEFAULT_TIMEOUT=120 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --no-deps -r intelligence/requirements.lock -w /wheels \
    && pip install --no-index --find-links=/wheels -r intelligence/requirements.lock

COPY intelligence/ intelligence/
COPY contracts/intelligence/v1/ contracts/intelligence/v1/

RUN pip wheel --no-cache-dir --no-build-isolation --no-deps ./intelligence -w /wheels \
    && pip wheel --no-cache-dir --no-build-isolation --no-deps ./intelligence/integrations -w /wheels

FROM python:3.12.15-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

COPY --from=build /wheels /wheels

RUN pip install --no-cache-dir --no-index --find-links=/wheels \
    /wheels/smart_service_intelligence-*.whl /wheels/smart_service_cloud_integration-*.whl \
    && rm -rf /wheels

WORKDIR /app

COPY scripts/intelligence/serve-cloud-assistance.py scripts/intelligence/serve-cloud-assistance.py
COPY scripts/intelligence/cloud-egress-proxy.py scripts/intelligence/cloud-egress-proxy.py

USER 10001:10001

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/intelligence/serve-cloud-assistance.py", "--installed", "--host", "0.0.0.0"]
